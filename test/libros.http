@host = http://localhost:8000
@contentType = application/json

# ==============================================================================
# LIBROS: CATÁLOGO, C-16 Y C-13 (E4, E5, E7) - Consigna págs. 21-23
#
# Antes de ejecutar este archivo, correr (deja siempre los mismos datos e ids):
#   python seed.py
# El archivo cambia los datos (repone, da de baja, carga un libro): para volver a
# correrlo, correr de nuevo el seed.
#
# Usuarios del seed que se usan:
#   admin@example.com    (ADMIN,    password: Admin123!)
#   vendedor@example.com (VENDEDOR, password: Vendedor123!)
#
# Libros del seed (id · título · stock):
#   1 · Rayuela 10 · 2 · Ficciones 8 · 3 · Bestiario 1 · 4 · Respiración artificial 3
#   5 · Antología de la literatura fantástica 5
# La venta 1 (de Lucía) tiene 1 Rayuela y 2 Ficciones.
#
# Sesiones: cada login tiene # @name y cada pedido con sesión usa # @no-cookie-jar
# con Cookie: {{loginX.response.headers.Set-Cookie}}, igual que test/seguridad.http.
# Para leer un dato de una respuesta anterior: {{nombre.response.body.$.id}}.
# ==============================================================================

@id_inexistente = 99999


### Inicio de sesión: ADMIN
# Esperado: 200 con Set-Cookie: access_token=...; HttpOnly
# @name loginAdmin
# @no-cookie-jar
POST {{host}}/auth/login
Content-Type: {{contentType}}

{
  "email": "admin@example.com",
  "password": "Admin123!"
}


### Inicio de sesión: VENDEDOR
# Esperado: 200 con Set-Cookie: access_token=...; HttpOnly
# @name loginVendedor
# @no-cookie-jar
POST {{host}}/auth/login
Content-Type: {{contentType}}

{
  "email": "vendedor@example.com",
  "password": "Vendedor123!"
}


# ==============================================================================
# CATÁLOGO PÚBLICO (grupo abierto: sin sesión)
# ==============================================================================

### Listado con el envoltorio
# Esperado: 200 con {"items": [...], "total": 5, "page": 1, "size": 20, "pages": 1}
# @no-cookie-jar
GET {{host}}/libros/


### Detalle de un libro con su editorial, género y autores
# Esperado: 200 con Rayuela, su editorial, su género y Julio Cortázar (rol autor, orden 1).
# Con SQL_ECHO=true se ven siempre 2 SELECT, tenga 1 o muchos autores.
# @no-cookie-jar
GET {{host}}/libros/1


### Detalle de un libro que no existe
# Esperado: 404 {"detail": "El libro no existe"}
# @no-cookie-jar
GET {{host}}/libros/{{id_inexistente}}


### Id que no es un entero
# Esperado: 422, sin ejecutar el handler
# @no-cookie-jar
GET {{host}}/libros/abc


### Búsqueda por parte del título, sin distinguir mayúsculas
# Esperado: 200 con total 1: Respiración artificial
# @no-cookie-jar
GET {{host}}/libros/?titulo=RESPIRA


### Listado filtrado por género
# Esperado: 200 con sólo los libros del género 1 (Novela) y el total contado con el mismo filtro
# @no-cookie-jar
GET {{host}}/libros/?genero_id=1


# ==============================================================================
# C-16 · Inyección en la búsqueda, paginación con filtro, PATCH parcial y PATCH del stock
# ==============================================================================

### C-16 (a) · Búsqueda con intento de inyección SQL
# Esperado: 200 con {"items": [], "total": 0, "page": 1, "size": 20, "pages": 1}.
# El texto viaja como parámetro ligado: se busca literalmente ' OR '1'='1.
# @no-cookie-jar
GET {{host}}/libros/?titulo=%27%20OR%20%271%27%3D%271


### C-16 (b) · Paginación con filtro
# Esperado: 200 con Ficciones, "total": 1 y "pages": 1
# @no-cookie-jar
GET {{host}}/libros/?titulo=ficc&size=1


### C-16 (c) · La misma búsqueda, página 2
# Esperado: 422 {"detail": "La página 2 no existe: hay 1"}
# @no-cookie-jar
GET {{host}}/libros/?titulo=ficc&size=1&page=2


### C-16 (d) · Tamaño de página fuera de rango
# Esperado: 422 (size va de 1 a 100)
# @no-cookie-jar
GET {{host}}/libros/?size=500


### C-16 (e) · PATCH parcial: sólo el precio
# Esperado: 200 con Bestiario en "precio": "19000.00"; el título, el stock (1) y los autores quedan igual
# @no-cookie-jar
PATCH {{host}}/libros/3
Content-Type: {{contentType}}
Cookie: {{loginAdmin.response.headers.Set-Cookie}}

{ "precio": "19000.00" }


### C-16 (f) · PATCH del stock
# Esperado: 422 (el stock sólo cambia con movimientos, RN-11; el contrato lo rechaza)
# @no-cookie-jar
PATCH {{host}}/libros/3
Content-Type: {{contentType}}
Cookie: {{loginAdmin.response.headers.Set-Cookie}}

{ "stock": 100 }


### PATCH con un campo en null
# Esperado: 422 (título y precio se omiten o se envían con valor)
# @no-cookie-jar
PATCH {{host}}/libros/3
Content-Type: {{contentType}}
Cookie: {{loginAdmin.response.headers.Set-Cookie}}

{ "titulo": null }


### PATCH de un libro que no existe
# Esperado: 404
# @no-cookie-jar
PATCH {{host}}/libros/{{id_inexistente}}
Content-Type: {{contentType}}
Cookie: {{loginAdmin.response.headers.Set-Cookie}}

{ "titulo": "No existe" }


# ==============================================================================
# C-13 · Reponer un libro; darlo de baja; volver a cargar el mismo ISBN
# ==============================================================================

### C-13 (a) · Reponer 5 ejemplares de Ficciones
# Esperado: 200 con "libro": {"id": 2, "stock": 13, ...} y "movimiento": {"cantidad": 5, "motivo": "Reposición", ...}
# @no-cookie-jar
POST {{host}}/libros/2/reponer
Content-Type: {{contentType}}
Cookie: {{loginAdmin.response.headers.Set-Cookie}}

{ "cantidad": 5 }


### C-13 (b) · Movimientos de Ficciones
# Esperado: 200 con "total": 3, del más viejo al más nuevo:
#   Stock inicial +10 · Venta -2 (venta 1) · Reposición +5. La suma (13) es el stock.
# @no-cookie-jar
GET {{host}}/libros/2/movimientos
Cookie: {{loginAdmin.response.headers.Set-Cookie}}


### Reponer con una cantidad inválida
# Esperado: 422 (la cantidad es un entero mayor o igual a 1)
# @no-cookie-jar
POST {{host}}/libros/2/reponer
Content-Type: {{contentType}}
Cookie: {{loginAdmin.response.headers.Set-Cookie}}

{ "cantidad": 0 }


### C-13 (c) · Dar de baja Rayuela (está en la venta 1)
# Esperado: 204 sin cuerpo. La fila queda en la tabla con borrado_en (baja lógica).
# @no-cookie-jar
DELETE {{host}}/libros/1
Cookie: {{loginAdmin.response.headers.Set-Cookie}}


### C-13 (d) · El libro dado de baja deja de aparecer en el catálogo: detalle
# Esperado: 404
# @no-cookie-jar
GET {{host}}/libros/1


### C-13 (e) · El libro dado de baja deja de aparecer en el catálogo: búsqueda
# Esperado: 200 con "items": [] y "total": 0
# @no-cookie-jar
GET {{host}}/libros/?titulo=rayuela


### C-13 (f) · Reponer el libro dado de baja
# Esperado: 409 {"detail": "El libro está dado de baja"} y ningún movimiento nuevo (RN-13)
# @no-cookie-jar
POST {{host}}/libros/1/reponer
Content-Type: {{contentType}}
Cookie: {{loginAdmin.response.headers.Set-Cookie}}

{ "cantidad": 3 }


### C-13 (g) · Dar de baja de nuevo el mismo libro
# Esperado: 404 (para el catálogo ya no existe)
# @no-cookie-jar
DELETE {{host}}/libros/1
Cookie: {{loginAdmin.response.headers.Set-Cookie}}


### C-13 (h) · Volver a cargar el ISBN de Rayuela
# Esperado: 201 con un id nuevo, "stock": 3 y el movimiento «Stock inicial» a nombre del ADMIN
# (el ISBN es único sólo entre los libros vigentes: índice único parcial, RN-01)
# @name rayuelaNueva
# @no-cookie-jar
POST {{host}}/libros/
Content-Type: {{contentType}}
Cookie: {{loginAdmin.response.headers.Set-Cookie}}

{
  "isbn": "978-950-00-0001-1",
  "titulo": "Rayuela",
  "precio": "26000.00",
  "stock_inicial": 3,
  "editorial_id": 1,
  "genero_id": 1,
  "autores": [{ "autor_id": 1, "rol": "autor", "orden": 1 }]
}


### C-13 (i) · Movimientos de la Rayuela nueva
# Esperado: 200 con "total": 1: Stock inicial +3
# @no-cookie-jar
GET {{host}}/libros/{{rayuelaNueva.response.body.$.id}}/movimientos
Cookie: {{loginAdmin.response.headers.Set-Cookie}}


### C-13 (j) · Un segundo libro vigente con el mismo ISBN
# Esperado: 409 {"detail": "El ISBN ya existe en un libro vigente o un autor figura dos veces en el libro"}
# @no-cookie-jar
POST {{host}}/libros/
Content-Type: {{contentType}}
Cookie: {{loginAdmin.response.headers.Set-Cookie}}

{
  "isbn": "978-950-00-0001-1",
  "titulo": "Rayuela (otra)",
  "precio": "26000.00",
  "stock_inicial": 1,
  "editorial_id": 1,
  "autores": []
}


### C-13 (k) · La venta vieja sigue mostrando el título del libro dado de baja
# Esperado: 200 con la venta 1 (total 69000.00) y su renglón de Rayuela con "titulo": "Rayuela"
# @no-cookie-jar
GET {{host}}/ventas/1
Cookie: {{loginAdmin.response.headers.Set-Cookie}}


# ==============================================================================
# ALTA RECHAZADA (en ningún caso se crea el libro)
# ==============================================================================

### Alta sin sesión
# Esperado: 401
# @no-cookie-jar
POST {{host}}/libros/
Content-Type: {{contentType}}

{
  "isbn": "TEST-0001",
  "titulo": "Sin sesión",
  "precio": "1500.00",
  "stock_inicial": 1,
  "editorial_id": 1,
  "autores": []
}


### Alta con un usuario sin el rol ADMIN
# Esperado: 403 (el VENDEDOR tiene sesión, pero requiere_rol("ADMIN") lo rechaza, RN-04)
# @no-cookie-jar
POST {{host}}/libros/
Content-Type: {{contentType}}
Cookie: {{loginVendedor.response.headers.Set-Cookie}}

{
  "isbn": "TEST-0002",
  "titulo": "Alta de un vendedor",
  "precio": "1500.00",
  "stock_inicial": 1,
  "editorial_id": 1,
  "autores": []
}


### Alta con stock en lugar de stock_inicial
# Esperado: 422 (extra="forbid": el stock nace del movimiento «Stock inicial», RN-11)
# @no-cookie-jar
POST {{host}}/libros/
Content-Type: {{contentType}}
Cookie: {{loginAdmin.response.headers.Set-Cookie}}

{
  "isbn": "TEST-0003",
  "titulo": "Con stock",
  "precio": "1500.00",
  "stock": 10,
  "editorial_id": 1,
  "autores": []
}


### Alta con precio en cero
# Esperado: 422 (el precio es mayor que 0)
# @no-cookie-jar
POST {{host}}/libros/
Content-Type: {{contentType}}
Cookie: {{loginAdmin.response.headers.Set-Cookie}}

{
  "isbn": "TEST-0004",
  "titulo": "Precio cero",
  "precio": "0",
  "stock_inicial": 1,
  "editorial_id": 1,
  "autores": []
}


### Alta con un rol de autor que no existe
# Esperado: 422 (los roles válidos son autor, coautor, traductor e ilustrador)
# @no-cookie-jar
POST {{host}}/libros/
Content-Type: {{contentType}}
Cookie: {{loginAdmin.response.headers.Set-Cookie}}

{
  "isbn": "TEST-0005",
  "titulo": "Rol inválido",
  "precio": "1500.00",
  "stock_inicial": 1,
  "editorial_id": 1,
  "autores": [{ "autor_id": 1, "rol": "jefe", "orden": 1 }]
}


### Alta con una editorial inexistente
# Esperado: 409 {"detail": "La editorial, el género o algún autor indicado no existe"}.
# La base rechaza la clave foránea; no hay consulta previa.
# @no-cookie-jar
POST {{host}}/libros/
Content-Type: {{contentType}}
Cookie: {{loginAdmin.response.headers.Set-Cookie}}

{
  "isbn": "TEST-0006",
  "titulo": "Editorial inexistente",
  "precio": "1500.00",
  "stock_inicial": 1,
  "editorial_id": {{id_inexistente}},
  "autores": []
}


### Alta con un autor inexistente
# Esperado: 409 con el mismo mensaje; el rollback deshace también el libro y su movimiento
# @no-cookie-jar
POST {{host}}/libros/
Content-Type: {{contentType}}
Cookie: {{loginAdmin.response.headers.Set-Cookie}}

{
  "isbn": "TEST-0007",
  "titulo": "Autor inexistente",
  "precio": "1500.00",
  "stock_inicial": 1,
  "editorial_id": 1,
  "autores": [{ "autor_id": {{id_inexistente}}, "rol": "autor", "orden": 1 }]
}


### Alta con un mismo autor dos veces
# Esperado: 409 (la clave primaria libro_id + autor_id de libro_autor lo impide)
# @no-cookie-jar
POST {{host}}/libros/
Content-Type: {{contentType}}
Cookie: {{loginAdmin.response.headers.Set-Cookie}}

{
  "isbn": "TEST-0008",
  "titulo": "Autor repetido",
  "precio": "1500.00",
  "stock_inicial": 1,
  "editorial_id": 1,
  "autores": [
    { "autor_id": 1, "rol": "autor", "orden": 1 },
    { "autor_id": 1, "rol": "coautor", "orden": 2 }
  ]
}


### Ningún alta rechazada dejó un libro
# Esperado: 200 con "total": 5 (los 4 vigentes del seed más la Rayuela nueva)
# @no-cookie-jar
GET {{host}}/libros/

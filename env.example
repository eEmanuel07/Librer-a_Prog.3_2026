# Copiar este archivo como .env y completar los valores.
# El archivo .env NO se sube al repositorio. Este ejemplo no lleva ningún secreto.

# --- Base de datos ---
# La dirección se arma sola con estas variables (driver postgresql+asyncpg).
POSTGRES_USER=postgres
# Obligatoria: si falta, la aplicación no arranca.
POSTGRES_PASSWORD=
POSTGRES_DB=libreria
POSTGRES_HOST=localhost
# Si mapeaste el contenedor a otro puerto (por ejemplo 5433), ponelo acá.
POSTGRES_PORT=5432

# Pool del motor: conexiones abiertas y extra en un pico.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# true muestra en la consola cada consulta SQL (evidencia del caso C-15).
SQL_ECHO=false

# --- Token y cookie ---
# Clave de firma de los tokens. Obligatoria, de al menos 32 caracteres.
# Se genera con:  python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=
# Duración del token (y Max-Age de la cookie), en minutos.
JWT_EXPIRA_MINUTOS=30
# true sólo detrás de HTTPS; en local (http://) tiene que ser false.
COOKIE_SECURE=false

# --- Contraseñas ---
# Costo de bcrypt (cada +1 duplica el tiempo del hash).
BCRYPT_COSTO=12
# Cuántos hash de bcrypt corren a la vez como máximo.
BCRYPT_CONCURRENCIA=4
